FROM node:20-slim

WORKDIR /app

# Copy dependency manifests
COPY package*.json ./

# Install all packages including devDependencies
RUN npm install

# Copy source code
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Start Vite dev server and expose it to the network (0.0.0.0)
CMD ["npm", "run", "dev", "--", "--host"]
